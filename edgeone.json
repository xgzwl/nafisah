{
  "name": "tom-riddle-shrine-edgeone",
  "buildCommand": "",
  "installCommand": "npm ci --no-audit --no-fund",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/tsconfig.json",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/package.json",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/edgeone.json",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/openapi.yaml",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/plan/PRD.md",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/plan/ARCHITECTURE.md",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/plan/UIUX.md",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/plan/SPEC.md",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/plan/decisions/ADR-001.md",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/plan/decisions/ADR-002.md",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/plan/decisions/ADR-003.md",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/plan/decisions/ADR-004.md",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/plan/decisions/ADR-005.md",
      "destination": "/404.html",
      "statusCode": 302
    },
    {
      "source": "/docs/plan/decisions/ADR-006.md",
      "destination": "/404.html",
      "statusCode": 302
    }
  ],
  "headers": [
    {
      "source": "/assets/img/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/css/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/js/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}